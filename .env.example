# Database (PostgreSQL 17 with Row-Level Security)
DATABASE_URL="postgresql://healthos:healthos_dev_password@localhost:5432/healthos?schema=public"

# Redis (Sessions, Revocation, Rate Limiting, Queues)
REDIS_URL="redis://localhost:6379"

# Security & Envelope Encryption (DO NOT USE DEV KEYS IN PRODUCTION)
# 32-byte hex master key (KEK) for local KMS provider; in prod use AWS_KMS or GCP_KMS
KMS_PROVIDER="local"
LOCAL_MASTER_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
BLIND_INDEX_KEY_HEX="fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"

# JWT & Session Security
JWT_ACCESS_SECRET="change-me-in-prod-min-64-chars-random-secret-access-key-healthos"
JWT_REFRESH_SECRET="change-me-in-prod-min-64-chars-random-secret-refresh-key-healthos"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# API Server
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"
