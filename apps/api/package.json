    "@nestjs/platform-express": "^11.0.10",
    "helmet": "^8.0.0",
    "jose": "^6.0.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
